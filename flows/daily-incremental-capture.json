{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Recurrence": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "UTC",
        "schedule": {
          "hours": [
            "11"
          ],
          "minutes": [
            0
          ]
        },
        "startTime": "<CONFIGURE_START_TIME_UTC>"
      },
      "type": "Recurrence"
    }
  },
  "actions": {
    "Run_a_query_against_a_dataset_1": {
      "runAfter": {},
      "type": "OpenApiConnection",
      "inputs": {
        "parameters": {
          "groupid": "<POWER_BI_WORKSPACE_ID>",
          "datasetid": "<POWER_BI_SEMANTIC_MODEL_ID>",
          "specification/query": "EVALUATE\nVAR UsageDate = TODAY() - 1\nRETURN\nSELECTCOLUMNS(\n FILTER(\n SUMMARIZECOLUMNS(\n 'Dates'[Date],\n 'Report pages'[SectionName],\n \"TotalPageUsers\", [Total page users],\n \"TotalPageViews\", [Total page views],\n \"PageViewShare\", [Page view share]\n ),\n 'Dates'[Date] = UsageDate\n ),\n \"Date\", 'Dates'[Date],\n \"PageName\", 'Report pages'[SectionName],\n \"TotalPageUsers\", [TotalPageUsers],\n \"TotalPageViews\", [TotalPageViews],\n \"PageViewShare\", [PageViewShare]\n)\n",
          "specification/serializerSettings/includeNulls": false
        },
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_powerbi",
          "connectionName": "<POWER_BI_CONNECTION_REFERENCE>",
          "operationId": "ExecuteDatasetQuery"
        },
        "authentication": "@parameters('$authentication')"
      }
    },
    "Apply_to_each_1": {
      "foreach": "@outputs('Run_a_query_against_a_dataset_1')?['body/firstTableRows']",
      "actions": {
        "Get_items": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "<SHAREPOINT_SITE_URL>",
              "table": "<SHAREPOINT_LIST_ID>",
              "$filter": "PageName eq '@{item()?['[PageName]']}'\nand UsageDate eq '@{item()?['[Date]']}'\n",
              "$top": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "<SHAREPOINT_CONNECTION_REFERENCE>",
              "operationId": "GetItems"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Condition": {
          "actions": {
            "Create_item_1_1": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "<SHAREPOINT_SITE_URL>",
                  "table": "<SHAREPOINT_LIST_ID>",
                  "item/UsageDate": "@formatDateTime(item()?['[Date]'], 'yyyy-MM-dd')",
                  "item/PageName": "@item()?['[PageName]']",
                  "item/TotalPageUsers": "@int(coalesce(item()?['[TotalPageUsers]'], 0))",
                  "item/TotalPageViews": "@int(coalesce(item()?['[TotalPageViews]'], 0))",
                  "item/PageViewShare": "@float(coalesce(item()?['[PageViewShare]'], 0))",
                  "item/CaptureDate": "@utcNow()"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "<SHAREPOINT_CONNECTION_REFERENCE>",
                  "operationId": "PostItem"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Get_items": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {}
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@length(body('Get_items')?['value'])",
                  0
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "runAfter": {
        "Run_a_query_against_a_dataset_1": [
          "Succeeded"
        ]
      },
      "type": "Foreach"
    }
  },
  "description": "Sanitized daily incremental example based on supplied definition. Checks for an existing page/date row before creating a new item. Verify date/time semantics and SharePoint OData filter behavior in your environment."
}
